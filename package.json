{
  "name": "clearday",
  "productName": "ClearDay",
  "version": "0.7.1",
  "description": "A compact, Monday-style daily task board that floats on your Mac desktop",
  "main": "src/main/main.mjs",
  "license": "MIT",
  "author": "Noam Elyasim",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "shots": "electron tools/shots/main.mjs",
    "e2e": "electron tools/e2e/main.mjs",
    "make-icon": "electron scripts/make-icon.mjs",
    "dist:mac": "bash scripts/build-native.sh && electron-builder --mac",
    "install:mac": "bash scripts/install-mac.sh",
    "build:native": "bash scripts/build-native.sh",
    "mcp": "node src/mcp/server.mjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.noam.clearday",
    "productName": "ClearDay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "ClearDay-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "src/mcp/**",
      "src/shared/**"
    ],
    "extraResources": [
      {
        "from": "build/native/cmdtap",
        "to": "cmdtap"
      }
    ]
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}
